lib_paths.extend([fmod_lib_dir + platform_dir + core_lib_dir + arch_dir, fmod_lib_dir + platform_dir + studio_lib_dir + arch_dir])

lib_prefix = "lib" if platform_arg != WEB and platform_arg != WINDOWS else ""

lib_suffixes = {
    MACOS: ".dylib",
    LINUX: ".so",
    WINDOWS:"_vc.lib",
    IOS: "_iphoneos.a",
    ANDROID: ".so",
    WEB: "_wasm.a",
}

core_lib = lib_prefix + "fmod" + lfix + lib_suffixes[platform_arg]

studio_lib = lib_prefix + "fmodstudio" + lfix + lib_suffixes[platform_arg]

# if platform_arg == WEB:
