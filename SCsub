libs.extend([File(fmod_lib_dir + platform_dir + core_lib_dir + arch_dir + core_lib), File(fmod_lib_dir + platform_dir + studio_lib_dir + arch_dir + studio_lib)])


if platform_arg == MACOS:
    link_flags.extend(
        [
            "-framework",
            "Cocoa",
            "-Wl,-undefined,dynamic_lookup",
            "-rpath", "@loader_path/.."
        ]
    )

elif platform_arg == LINUX:
    cc_flags.extend(["-fPIC", "-Wwrite-strings"])
    
    link_flags.extend(["-Wl,-R,'$$ORIGIN'", "-m64", "-fuse-ld=gold"])

elif platform_arg == WINDOWS:
    link_flags.extend(["/WX"])
    
    if debug:
        cc_flags.extend(["/FS", "/Zi"])

elif platform_arg == IOS:
    link_flags.extend([
        '-Wl,-undefined,dynamic_lookup', "-miphoneos-version-min=" + env["ios_min_version"]
    ])

elif platform_arg == WEB:
    link_flags.extend(["-sEXPORTED_RUNTIME_METHODS=ccall,cwrap,setValue,getValue"])

